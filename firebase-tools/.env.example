# Firebase seed script credentials
# Copy to .env or export these in your shell / CI secrets.

# Option A: Raw JSON of the service account key (for CI/CD)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"moments-e2a58",...}

# Option B: Path to your service account key file (for local dev)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Optional overrides (defaults set in scripts)
# FIREBASE_PROJECT_ID=moments-e2a58
# FIREBASE_STORAGE_BUCKET=moments-e2a58.firebasestorage.app

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidUserProfile(data) {
      return data.keys().hasOnly([
        'fullName',
        'username',
        'email',
        'bio',
        'interests',
        'profileImageURL',
        'momentsCount',
        'friendsCount',
        'likesCount',
        'createdAt'
      ]) &&
      data.fullName is string &&
      data.fullName.size() > 0 &&
      data.fullName.size() <= 80 &&
      data.username is string &&
      data.username.size() > 0 &&
      data.username.size() <= 30 &&
      data.email is string &&
      data.email.size() > 3 &&
      data.bio is string &&
      data.bio.size() <= 300 &&
      data.interests is list &&
      data.interests.size() <= 20 &&
      (!('profileImageURL' in data) || data.profileImageURL == null || data.profileImageURL is string) &&
      data.momentsCount is int &&
      data.friendsCount is int &&
      data.likesCount is int &&
      data.createdAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasOnly([
        'authorUID',
        'authorUsername',
        'authorProfileImageURL',
        'body',
        'imageURL',
        'tag',
        'likes',
        'likedByUIDs',
        'commentCount',
        'createdAt'
      ]) &&
      data.authorUID is string &&
      data.authorUsername is string &&
      data.authorUsername.size() > 0 &&
      data.authorUsername.size() <= 30 &&
      (!('authorProfileImageURL' in data) || data.authorProfileImageURL == null || data.authorProfileImageURL is string) &&
      data.body is string &&
      data.body.size() > 0 &&
      data.body.size() <= 1000 &&
      (!('imageURL' in data) || data.imageURL == null || data.imageURL is string) &&
      (!('tag' in data) || data.tag == null || data.tag is string) &&
      data.likes is int &&
      data.commentCount is int &&
      data.likedByUIDs is list &&
      data.createdAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasOnly([
        'authorUID',
        'authorUsername',
        'body',
        'likes',
        'createdAt'
      ]) &&
      data.authorUID is string &&
      data.authorUsername is string &&
      data.authorUsername.size() > 0 &&
      data.authorUsername.size() <= 30 &&
      data.body is string &&
      data.body.size() > 0 &&
      data.body.size() <= 500 &&
      data.likes is int &&
      data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    match /dishes/{dishId} {
      allow read: if isSignedIn();
    }

    match /appContent/{documentId} {
      allow read: if true;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.authorUID == request.auth.uid &&
        isValidPost(request.resource.data);

      allow update: if isSignedIn() &&
        isValidPost(request.resource.data) &&
        (
          (
            request.auth.uid == resource.data.authorUID &&
            request.resource.data.authorUID == resource.data.authorUID &&
            request.resource.data.authorUsername == resource.data.authorUsername &&
            request.resource.data.authorProfileImageURL == resource.data.authorProfileImageURL &&
            request.resource.data.createdAt == resource.data.createdAt
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedByUIDs']) &&
            request.resource.data.authorUID == resource.data.authorUID &&
            request.resource.data.authorUsername == resource.data.authorUsername &&
            request.resource.data.authorProfileImageURL == resource.data.authorProfileImageURL &&
            request.resource.data.body == resource.data.body &&
            request.resource.data.imageURL == resource.data.imageURL &&
            request.resource.data.tag == resource.data.tag &&
            request.resource.data.commentCount == resource.data.commentCount &&
            request.resource.data.createdAt == resource.data.createdAt
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
            request.resource.data.authorUID == resource.data.authorUID &&
            request.resource.data.authorUsername == resource.data.authorUsername &&
            request.resource.data.authorProfileImageURL == resource.data.authorProfileImageURL &&
            request.resource.data.body == resource.data.body &&
            request.resource.data.imageURL == resource.data.imageURL &&
            request.resource.data.tag == resource.data.tag &&
            request.resource.data.likes == resource.data.likes &&
            request.resource.data.likedByUIDs == resource.data.likedByUIDs &&
            request.resource.data.createdAt == resource.data.createdAt
          )
        );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUID;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.authorUID == request.auth.uid &&
          isValidComment(request.resource.data);
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUID;
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidUserProfile(data) {
      return data.keys().hasOnly([
        'fullName',
        'username',
        'email',
        'bio',
        'interests',
        'profileImageURL',
        'momentsCount',
        'friendsCount',
        'likesCount',
        'createdAt'
      ]) &&
      data.fullName is string &&
      data.fullName.size() > 0 &&
      data.fullName.size() <= 80 &&
      data.username is string &&
      data.username.size() > 0 &&
      data.username.size() <= 30 &&
      data.username.matches('^[a-zA-Z0-9._]{2,30}$') &&
      data.email is string &&
      data.email.size() > 3 &&
      data.bio is string &&
      data.bio.size() <= 300 &&
      data.interests is list &&
      data.interests.size() <= 20 &&
      (!('profileImageURL' in data) || data.profileImageURL == null || data.profileImageURL is string) &&
      data.momentsCount is int && data.momentsCount >= 0 &&
      data.friendsCount is int && data.friendsCount >= 0 &&
      data.likesCount is int && data.likesCount >= 0 &&
      data.createdAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasOnly([
        'authorUID',
        'authorUsername',
        'authorProfileImageURL',
        'body',
        'imageURL',
        'tag',
        'likes',
        'likedByUIDs',
        'commentCount',
        'createdAt'
      ]) &&
      data.authorUID is string &&
      data.authorUsername is string &&
      data.authorUsername.size() > 0 &&
      data.authorUsername.size() <= 30 &&
      (!('authorProfileImageURL' in data) || data.authorProfileImageURL == null || data.authorProfileImageURL is string) &&
      data.body is string &&
      data.body.size() > 0 &&
      data.body.size() <= 1000 &&
      (!('imageURL' in data) || data.imageURL == null || data.imageURL is string) &&
      (!('tag' in data) || data.tag == null || data.tag is string) &&
      (!('likes' in data) || (data.likes is int && data.likes >= 0)) &&
      (!('commentCount' in data) || (data.commentCount is int && data.commentCount >= 0)) &&
      (!('likedByUIDs' in data) || data.likedByUIDs is list) &&
      data.createdAt is timestamp;
    }

    function postLikes(data) {
      return ('likes' in data && data.likes is int) ? data.likes : 0;
    }

    function postCommentCount(data) {
      return ('commentCount' in data && data.commentCount is int) ? data.commentCount : 0;
    }

    function postLikedByUIDs(data) {
      return ('likedByUIDs' in data && data.likedByUIDs is list) ? data.likedByUIDs : [];
    }

    function isValidComment(data) {
      return data.keys().hasOnly([
        'authorUID',
        'authorUsername',
        'authorProfileImageURL',
        'body',
        'likes',
        'likedByUIDs',
        'createdAt'
      ]) &&
      data.authorUID is string &&
      data.authorUsername is string &&
      data.authorUsername.size() > 0 &&
      data.authorUsername.size() <= 30 &&
      (!('authorProfileImageURL' in data) || data.authorProfileImageURL == null || data.authorProfileImageURL is string) &&
      data.body is string &&
      data.body.size() > 0 &&
      data.body.size() <= 500 &&
      data.likes is int && data.likes >= 0 &&
      data.likedByUIDs is list &&
      data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasOnly([
        'reporterUID',
        'postID',
        'commentID',
        'reason',
        'createdAt'
      ]) &&
      data.reporterUID is string &&
      data.postID is string &&
      (!('commentID' in data) || data.commentID == null || data.commentID is string) &&
      data.reason is string &&
      data.reason.size() > 0 &&
      data.reason.size() <= 200 &&
      data.createdAt is timestamp;
    }

    function isValidCompletedMoment(data) {
      return data.keys().hasOnly([
        'title',
        'vibe',
        'playlistId',
        'dishIds',
        'gameNumbers',
        'startedAt',
        'endedAt'
      ]) &&
      data.title is string && data.title.size() <= 100 &&
      data.vibe is string &&
      (!('playlistId' in data) || data.playlistId == null || data.playlistId is string) &&
      data.dishIds is list &&
      data.gameNumbers is list &&
      data.startedAt is timestamp &&
      data.endedAt is timestamp &&
      data.endedAt >= data.startedAt;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId) &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      match /moments/{momentId} {
        // Users can only read/write their own moment history
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCompletedMoment(request.resource.data);
        // History is immutable — no updates or deletes from the client
      }
    }

    match /dishes/{dishId} {
      allow read: if isSignedIn();
    }

    match /drinks/{drinkId} {
      allow read: if isSignedIn();
    }

    match /appContent/{documentId} {
      allow read: if true;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.authorUID == request.auth.uid &&
        isValidPost(request.resource.data) &&
        // Soft rate-limit: reject posts backdated or dated more than 30s in the future.
        // This doesn't prevent burst writes but blocks trivial timestamp manipulation.
        request.resource.data.createdAt >= request.time - duration.value(30, 's') &&
        request.resource.data.createdAt <= request.time + duration.value(30, 's');

      allow update: if isSignedIn() &&
        isValidPost(request.resource.data) &&
        (
          (
            request.auth.uid == resource.data.authorUID &&
            request.resource.data.authorUID == resource.data.authorUID &&
            request.resource.data.authorUsername == resource.data.authorUsername &&
            request.resource.data.authorProfileImageURL == resource.data.authorProfileImageURL &&
            request.resource.data.createdAt == resource.data.createdAt
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedByUIDs']) &&
            request.resource.data.authorUID == resource.data.authorUID &&
            request.resource.data.authorUsername == resource.data.authorUsername &&
            request.resource.data.authorProfileImageURL == resource.data.authorProfileImageURL &&
            request.resource.data.body == resource.data.body &&
            request.resource.data.imageURL == resource.data.imageURL &&
            request.resource.data.tag == resource.data.tag &&
            request.resource.data.commentCount == resource.data.commentCount &&
            request.resource.data.createdAt == resource.data.createdAt &&
            (
              (request.resource.data.likes == resource.data.likes + 1 &&
               request.resource.data.likedByUIDs.hasAll([request.auth.uid]) &&
               !resource.data.likedByUIDs.hasAll([request.auth.uid]))
              ||
              (request.resource.data.likes == resource.data.likes - 1 &&
               !request.resource.data.likedByUIDs.hasAll([request.auth.uid]) &&
               resource.data.likedByUIDs.hasAll([request.auth.uid]))
            )
          ) ||
          (
            // LOW fix: commentCount can only increment by 1 or decrement by 1
            // with a floor of 0 — prevents the count going negative on race.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
            request.resource.data.authorUID == resource.data.authorUID &&
            request.resource.data.authorUsername == resource.data.authorUsername &&
            request.resource.data.authorProfileImageURL == resource.data.authorProfileImageURL &&
            request.resource.data.body == resource.data.body &&
            request.resource.data.imageURL == resource.data.imageURL &&
            request.resource.data.tag == resource.data.tag &&
            postLikes(request.resource.data) == postLikes(resource.data) &&
            postLikedByUIDs(request.resource.data) == postLikedByUIDs(resource.data) &&
            request.resource.data.createdAt == resource.data.createdAt &&
            (
              postCommentCount(request.resource.data) == postCommentCount(resource.data) + 1 ||
              (postCommentCount(request.resource.data) == postCommentCount(resource.data) - 1 &&
               postCommentCount(resource.data) > 0)
            )
          )
        );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUID;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.authorUID == request.auth.uid &&
          isValidComment(request.resource.data);
        allow update: if isSignedIn() &&
          isValidComment(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedByUIDs']) &&
          request.resource.data.authorUID == resource.data.authorUID &&
          request.resource.data.authorUsername == resource.data.authorUsername &&
          request.resource.data.authorProfileImageURL == resource.data.authorProfileImageURL &&
          request.resource.data.body == resource.data.body &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (
            (request.resource.data.likes == resource.data.likes + 1 &&
             request.resource.data.likedByUIDs.hasAll([request.auth.uid]) &&
             !resource.data.likedByUIDs.hasAll([request.auth.uid]))
            ||
            (request.resource.data.likes == resource.data.likes - 1 &&
             !request.resource.data.likedByUIDs.hasAll([request.auth.uid]) &&
             resource.data.likedByUIDs.hasAll([request.auth.uid]))
          );
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUID;
      }
    }

    match /reports/{reportId} {
      // Reports are write-only for authenticated users; only admins can read.
      // Using a uid-postId composite as the document ID prevents duplicate reports.
      allow create: if isSignedIn() &&
        request.resource.data.reporterUID == request.auth.uid &&
        isValidReport(request.resource.data);
      // No read/update/delete for users — reports are admin-only
    }
  }
}
